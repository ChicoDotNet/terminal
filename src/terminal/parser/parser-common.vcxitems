<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Contains all the files for the Parser Project.
   -->
  <PropertyGroup>
    <_RustParserTargetTriple Condition="'$(Platform)'=='x64'">x86_64-pc-windows-msvc</_RustParserTargetTriple>
    <_RustParserTargetTriple Condition="'$(Platform)'=='Win32'">i686-pc-windows-msvc</_RustParserTargetTriple>
    <_RustParserTargetTriple Condition="'$(Platform)'=='ARM64'">aarch64-pc-windows-msvc</_RustParserTargetTriple>
    <_RustParserCargoProfile Condition="'$(Configuration)'=='Debug'">debug</_RustParserCargoProfile>
    <_RustParserCargoProfile Condition="'$(Configuration)'!='Debug'">release</_RustParserCargoProfile>
    <_RustParserCargoReleaseArg Condition="'$(Configuration)'!='Debug'">--release</_RustParserCargoReleaseArg>
    <_RustParserFfiLib>$(SolutionDir)artifacts\cargo-target\$(_RustParserTargetTriple)\$(_RustParserCargoProfile)\terminal_parser_ffi.lib</_RustParserFfiLib>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)rust\terminal-parser-ffi\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(_RustParserFfiLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Lib>
      <AdditionalDependencies>$(_RustParserFfiLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>
  <Target Name="BuildRustTerminalParserFfi" BeforeTargets="ClCompile">
    <Error Condition="'$(_RustParserTargetTriple)'==''" Text="R09 parser Rust integration does not support MSBuild platform '$(Platform)'." />
    <Exec WorkingDirectory="$(SolutionDir)" Command="rustup target add $(_RustParserTargetTriple)" />
    <Exec WorkingDirectory="$(SolutionDir)" Command="cargo build --locked -p terminal-parser-ffi --target $(_RustParserTargetTriple) $(_RustParserCargoReleaseArg)" />
  </Target>
  <ItemGroup>
    <ClCompile Include="..\OutputStateMachineEngine.cpp" />
    <ClCompile Include="..\stateMachine.cpp" />
    <ClCompile Include="..\tracing.cpp" />
    <ClCompile Include="..\precomp.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\ascii.hpp" />
    <ClInclude Include="..\precomp.h" />
    <ClInclude Include="..\stateMachine.hpp" />
    <ClInclude Include="..\IStateMachineEngine.hpp" />
    <ClInclude Include="..\OutputStateMachineEngine.hpp" />
    <ClInclude Include="..\tracing.hpp" />
    <ClInclude Include="..\base64.hpp" />
  </ItemGroup>
</Project>
